# Slack bot token (xoxb-...) with chat:write OAuth scope
# Create a Slack app at https://api.slack.com/apps → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-token-here

# Slack channel to post the digest into (e.g. C0123ABCD).
# The bot must be a member of the channel — invite it: /invite @<bot-name>
# Find the ID: open the channel → click its name → bottom of the About tab.
SLACK_CHANNEL_ID=C0123ABCD

# Fallback only: DM this user if SLACK_CHANNEL_ID is unset (e.g. U012AB3CD)
# SLACK_USER_ID=U012AB3CD

# Google Play app package name (e.g. care.freed.ifree)
PLAY_STORE_APP_ID=care.freed.ifree
